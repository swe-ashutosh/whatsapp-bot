# Server Configuration
PORT=3000
APP_NAME=HisabDesk WhatsApp Gateway

# API Authentication (Used by HisabDesk to send messages via x-api-key header)
API_KEY=change-this-to-a-strong-api-key

# Web Dashboard Admin Credentials (Default password must be changed on first login)
ADMIN_USER=admin
ADMIN_PASSWORD=hisabdesk123

# Session Identifier (Keep unique per WhatsApp number when sharing a D1 database)
SESSION_ID=session-1

# HisabDesk D1 HTTP Sync & Activation URLs
D1_SYNC_URL=https://api.hisabdesk.in/api/hb/whatsapp/session
HISABDESK_ACTIVATE_URL=https://app.hisabdesk.in

# Render Keep-Alive Self-Ping (Uses RENDER_EXTERNAL_URL/health with 0 D1 calls)
KEEP_ALIVE=true

# Local Baileys Auth Storage Path (Fallback when D1_SYNC_URL is unset)
AUTH_DIR=./auth_info_baileys

# Anti-Ban Controls
MIN_DELAY_MS=10000
MAX_DELAY_MS=20000
COOLDOWN_EVERY_N=25
COOLDOWN_MIN_MS=60000
COOLDOWN_MAX_MS=300000
MAX_MESSAGES_PER_HOUR=150
MAX_MESSAGES_PER_DAY=1000
DUPLICATE_WINDOW_MS=60000
AUTO_MESSAGE_VARIATION=true
